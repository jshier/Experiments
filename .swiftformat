# file options

--symlinks ignore
--swiftversion 6.4
--language-mode 6

# format options

--binary-grouping ignore
--commas collections-only
--comments indent
--decimal-grouping ignore
--exponentcase lowercase
--exponentgrouping disabled
--fractiongrouping disabled
--hex-grouping ignore
--ifdef preserve
--importgrouping testable-top
--operatorfunc no-space
--nospaceoperators ..<, ...
--selfrequired validate
--someAny false
--stripunusedargs closure-only
--suite-name-format preserve
--test-case-name-format preserve
--wraparguments preserve
--wrapcollections preserve
--wrapparameters preserve

# rules

--enable isEmpty
--disable andOperator
--disable docComments
--disable noForceTryInTests
--disable noForceUnwrapInTests
--disable opaqueGenericParameters
--disable redundantSwiftTestingSuite
--disable simplifyGenericConstraints
--disable wrapFunctionBodies
--disable wrapIfExpressionBodies
--disable wrapIfStatementBodies
--disable wrapMultilineStatementBraces
--disable wrapPropertyBodies
