#!/bin/bash
# counters — what each thread's CPU actually did, from the performance counters (Instruments' CPU Counters
# instrument, recorded with xctrace). No sudo. The runtime check for vectorization: SIMD instruction counts.
#
# usage: Tools/counters [--mode MODE] [--keep FILE.trace] [--time-limit T] [--timeout S] -- PROGRAM [ARGS...]
#        Tools/counters [--mode MODE] --trace FILE.trace
#        Tools/counters --list-modes
#
# Modes (Instruments' names; --list-modes prints all, with their metrics, from Xcode's own definitions):
#   bottlenecks (default)   share of cycles: useful (retiring), discarded (mispredicted work), delivery
#                           (front end: fetch, decode, i-cache), processing (back end: execution units, memory)
#   delivery                front-end breakdown: latency (i-cache, i-TLB), bandwidth (taken branches)
#   simd_fp_unit_instructions        counts of SIMD/FP arithmetic, loads, and stores — 0 means scalar code
#   branch_simd_vector_instructions  branches, taken branches, SIMD vector arithmetic
#   call_branch_instructions, l1d_metrics, data_address_translation_metrics, …
# Not every mode records on every CPU: on the M1 Max, processing, sme_streaming, and sme_engine_instructions record
# nothing (the tool says so and exits 2), and the *_sampling modes record samples whose shares come out as "-" here
# (open the recording in Instruments for them).
#
# Output, tab-separated, per thread with cycles, busiest first:
#   bottleneck modes:  thread, cycles, then each metric's share of the mode's total, "name 12.3%"
#   count modes:       thread, cycles, then each metric's count and per cycle, "name count (per cycle)"
# Cycles and counts are exact integers; per cycle has 4 significant digits. (Bottleneck modes' tables hold every
# interval twice, at 1 ms and 10 ms: only the 1 ms rows are counted. Before 2026-11-24 their cycles read double.) Counts are summed over all cores (P and
# E). Per cycle and per unit of work (divide by your iterations) is the useful form: e.g. SIMD arithmetic per 48-byte
# block equals the vector instructions in the loop.
#
#   --keep FILE.trace   keep the recording (open it in Instruments for timelines and per-function detail): a new
#                       path ending in .trace, or an earlier recording (replaced)
#   --time-limit T      stop recording after T (xctrace's units: 500ms, 5s, 2m; plain numbers are seconds) and
#                       report what was counted; PROGRAM is ended
#   --timeout S         without --time-limit, a run longer than S seconds (default 300) is stopped and the tool fails
#
# xctrace itself stops PROGRAM at the time limit; if xctrace hangs past that (waiting on an authorization prompt),
# it's interrupted 60 s later, and only the processes it started are stopped.
source "$(dirname "$0")/lib/common.sh" || exit 2
have yq || die "needs yq: brew install yq"
have jq || die "needs jq: brew install jq"
definitions="$(xcode-select -p)/../SharedFrameworks/RecountDT.framework/Versions/A/Resources/Analysis"

mode=bottlenecks trace='' keep='' limit='' timeout=300
while [[ $# -gt 0 ]]; do
    case "$1" in
        --mode) need_value "$@"; mode="$2"; shift ;;
        --trace) need_value "$@"; trace="$2"; shift ;;
        --keep) need_value "$@"; keep="$2"; shift ;;
        --time-limit) need_value "$@"; limit="$2"; shift ;;
        --timeout) need_value "$@"; need_number "$1" "$2"; timeout="$2"; shift ;;
        --list-modes)
            jq -r '.name as $analysis | .modes[] | [$analysis, .name, .display_name, ([.metrics[]?.name] | join(","))] | @tsv' "$definitions"/*.json
            exit 0 ;;
        -h|--help) usage ;;
        --) shift; break ;;
        *) die "unknown option $1" ;;
    esac
    shift
done
analysis="$(jq -r --arg m "$mode" 'select(any(.modes[]; .name == $m)) | .name' "$definitions"/*.json 2>/dev/null | head -1)"
[[ -n "$analysis" ]] || die "unknown mode $mode (Tools/counters --list-modes)"

# xctrace's --time-limit in whole seconds (rounded up), for the backstop; dies on anything else: no leading zeros
# (bash would read 08 as octal), and at most 10,000,000 s, so the arithmetic can't wrap.
limit_seconds() {
    local number unit seconds
    [[ "$1" =~ ^([1-9][0-9]{0,9})(ms|s|m|h)?$ ]] ||
        die "--time-limit takes a whole number from 1, with ms, s, m, or h (5s), not '$1'"
    number="${BASH_REMATCH[1]}" unit="${BASH_REMATCH[2]}"
    need_number --time-limit "$number"
    case "$unit" in
        ms) seconds=$(((number + 999) / 1000)) ;;
        m) seconds=$((number * 60)) ;;
        h) seconds=$((number * 3600)) ;;
        *) seconds="$number" ;;
    esac
    (( seconds <= 10000000 )) || die "--time-limit $1 is longer than 10,000,000 s"
    echo "$seconds"
}

# What the recording's table of contents says: how it ended, and the CPU Counters mode it was recorded in.
toc() {
    [[ -f "$SCRATCH/toc.xml" ]] || xctrace export --input "$trace" --toc > "$SCRATCH/toc.xml" 2> /dev/null || true
    perl -ne "print \$1 if m{$1}" "$SCRATCH/toc.xml" 2> /dev/null || true
}
ended() { local reason; reason="$(toc '<end-reason>(.*?)</end-reason>')"; [[ -z "$reason" ]] || echo " (the recording ended: $reason)"; }

# --keep: a path ending in .trace that doesn't exist, or an earlier recording (a .trace directory with Instruments'
# form.template), which is replaced. Anything else is refused, never removed.
check_keep() {
    [[ "$1" == *.trace ]] || die "--keep takes a path ending in .trace: $1"
    if [[ -e "$1" || -L "$1" ]]; then
        [[ -d "$1" && ! -L "$1" && -f "$1/form.template" ]] ||
            die "--keep $1 exists and isn't an Instruments recording: refusing to replace it"
    fi
}

scratch_dir
if [[ -z "$trace" ]]; then
    [[ $# -ge 1 ]] || usage 2
    recording_limit="${timeout}s"
    backstop="$timeout"
    if [[ -n "$limit" ]]; then
        seconds="$(limit_seconds "$limit")"
        [[ "$limit" =~ [a-z]$ ]] || limit="${limit}s"
        recording_limit="$limit"
        (( seconds > backstop )) && backstop="$seconds"
    fi
    program="$(debuggable "$1")"; shift
    [[ -z "$keep" ]] || check_keep "$keep"
    trace="${keep:-$SCRATCH/run.trace}"
    with_timeout 60 xctrace record --template 'CPU Counters' --show-recording-options > "$SCRATCH/template.json" 2>/dev/null ||
        die "xctrace couldn't list the CPU Counters template's options"
    jq --arg a "$analysis" --arg c "$mode" '.["CPU Counters"].selectedCountingMode = {analysisMode: $a, countingMode: $c}' \
        "$SCRATCH/template.json" > "$SCRATCH/options.json"
    [[ ! -d "$trace" ]] || rm -rf "$trace"
    note "recording $(basename "$program") with CPU Counters ($mode)…"
    status=0
    with_timeout $((backstop + 60)) xctrace record --template 'CPU Counters' --recording-options "$SCRATCH/options.json" \
        --output "$trace" --time-limit "$recording_limit" --launch -- "$program" "$@" \
        > "$SCRATCH/record.log" 2>&1 < /dev/null || status=$?
    [[ $status != 124 ]] || fail "xctrace didn't finish within $((backstop + 60)) s and was stopped ($AUTH_HINT)"
    [[ -d "$trace" ]] || { tail -5 "$SCRATCH/record.log" >&2; die "xctrace record failed ($AUTH_HINT)"; }
    if [[ -z "$limit" ]] && grep -q 'Reached specified time limit' "$SCRATCH/record.log"; then
        fail "$(basename "$program") didn't finish in ${timeout} s (--timeout) and was stopped${keep:+; the recording is in $keep}"
    fi
fi
[[ -d "$trace" ]] || die "no trace $trace"

# xctrace writes each repeated value once, with an "id", and later as {"ref": id}. `resolve` maps them back.
resolve='([.. | objects | select(has("+@id"))] | map({key: .["+@id"], value: .}) | from_entries) as $ids
    | def r: if type == "object" and has("+@ref") then $ids[.["+@ref"]] else . end;
    def rows: .["trace-query-result"].node.row // [] | if type == "array" then .[] else . end;'
# A table as JSON, through files: under `set -e` a failing export in a pipeline would end the tool with 1 and no word.
export_table() {
    if ! { xctrace export --input "$trace" --xpath "/trace-toc/run[@number=\"1\"]/data/table[@schema=\"$1\"]" \
        > "$SCRATCH/table.xml" 2> "$SCRATCH/export.err" && yq -p xml -o json '.' "$SCRATCH/table.xml" > "$SCRATCH/table.json"; }; then
        # No such table: some modes record nothing on some CPUs (on the M1 Max: processing, sme_streaming,
        # sme_engine_instructions), and a failed recording has none either.
        if grep -q 'did not match anything' "$SCRATCH/export.err"; then
            die "$trace has no $1 table$(ended): mode $mode recorded nothing (not every mode works on every CPU; Tools/counters --list-modes)"
        fi
        tail -3 "$SCRATCH/export.err" >&2
        die "xctrace couldn't export $1 from $trace"
    fi
    # A recording made in another mode has rows of other metrics (the table of contents names the template's default
    # mode, not the one recorded): when none of this mode's metrics is there, say so rather than print nonsense.
    local present wanted
    present="$(jq -r "$resolve"'[rows | .string | if type == "array" then .[0] else . end | r | .["+content"] // empty]
        | unique | map(select(. != "cycle")) | join(",")' "$SCRATCH/table.json")"
    wanted="$(jq -r --arg m "$mode" '.modes[]? | select(.name == $m) | [.metrics[]?.name | select(. != "cycle")] | join(",")' \
        "$definitions"/*.json 2> /dev/null | head -1)"
    if [[ -n "$present" && -n "$wanted" ]] &&
        ! PRESENT="$present" WANTED="$wanted" perl -e 'my %p = map { $_ => 1 } split /,/, $ENV{PRESENT};
            exit((grep { $p{$_} } split /,/, $ENV{WANTED}) ? 0 : 1)'; then
        die "$trace was recorded in another mode: its metrics are $present, not --mode $mode's ($wanted)"
    fi
}

if [[ "$analysis" == bottleneck ]]; then
    # Relative weights per time slice in MetricAggregationForThread; cycles as integers.
    export_table MetricAggregationForThread
    # The table holds each interval twice, as precise rows (1 ms) and imprecise ones (10 ms): summing both counted
    # every cycle twice. Only the precise rows are used when there are any.
    jq -r "$resolve"'
        [rows | {thread: (.thread | r | .["+@fmt"]), name: (.string | r | .["+content"]),
                 precise: (.boolean | if type == "array" then .[0] else . end | r | .["+content"] // ""),
                 int: ((.uint64 | r | .["+content"]) // "0" | tonumber),
                 double: ((.["fixed-decimal"] | r | .["+content"]) // "0" | tonumber)}]
        | (if any(.[]; .precise == "1") then map(select(.precise == "1")) else . end)
        | group_by(.thread)
        | map({thread: .[0].thread, cycles: (map(select(.name == "cycle") | .int) | add // 0),
               metrics: (map(select(.name != "cycle")) | group_by(.name) | map({key: .[0].name, value: (map(.double) | add)}) | from_entries)})
        | map(select(.cycles > 0)) | sort_by(-.cycles)
        | .[] | (.metrics | add) as $total
        | [.thread, (.cycles | tostring)]
          + (.metrics | to_entries | map("\(.key) " + (if $total > 0 then (.value / $total * 1000 | round / 10 | tostring) + "%" else "-" end)))
        | @tsv' "$SCRATCH/table.json" > "$SCRATCH/result.tsv"
else
    # Event counts per thread in MetricTableForThread. jq leaves the per-cycle ratio unrounded ("<r:…>"); Perl prints
    # it with 4 significant digits.
    export_table MetricTableForThread
    jq -r "$resolve"'
        [rows | {thread: (.thread | r | .["+@fmt"]),
                 name: (.string | if type == "array" then .[0] else . end | r | .["+content"]),
                 value: ((.["non-zero-uint64"] // .uint64 // {"+content": "0"}) | r | .["+content"] // "0" | tonumber)}]
        | group_by(.thread)
        | map({thread: .[0].thread, cycles: (map(select(.name == "cycle") | .value) | add // 0),
               metrics: (map(select(.name != "cycle")) | group_by(.name) | map({key: .[0].name, value: (map(.value) | add)}) | from_entries)})
        | map(select(.cycles > 0)) | sort_by(-.cycles)
        | .[] | .cycles as $cycles
        | [.thread, (.cycles | tostring)]
          + (.metrics | to_entries | map("\(.key) \(.value) (<r:\(.value / $cycles)>)"))
        | @tsv' "$SCRATCH/table.json" | perl -pe 's/<r:([^>]+)>/sprintf("%.4g", $1)/ge' > "$SCRATCH/result.tsv"
fi
# An empty table (a recording that failed, or that no thread ran in) prints nothing: say why, and fail.
[[ -s "$SCRATCH/result.tsv" ]] || die "no thread had cycles in $trace$(ended)"
cat "$SCRATCH/result.tsv"
