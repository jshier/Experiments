#!/bin/bash
# tasks — what each Swift task actually did, from Instruments' Swift Concurrency template (recorded with
# xctrace): where it ran, whether it hopped between threads or actors, how long it waited for its executor,
# and how often it suspended on a continuation (I/O, `withCheckedContinuation`, …).
#
# usage: Tools/tasks [--top N] [--keep FILE.trace] [--time-limit T] [--timeout S] -- PROGRAM [ARGS...]
#        Tools/tasks [--top N] --trace FILE.trace
#
#   --top N            tasks listed (default 20)
#   --keep FILE.trace  keep the recording: a new path ending in .trace, or an earlier recording (replaced)
#   --time-limit T     stop recording after T (xctrace's units: 500ms, 5s, 2m; plain numbers are seconds) and
#                      summarize what was recorded; PROGRAM is ended
#   --timeout S        without --time-limit, a run longer than S seconds (default 300) is stopped and the tool fails
#
# Output, tab-separated, three tables under "==" headers:
#   == tasks (busiest first, --top N, default 20): task, runs (Running intervals), running time,
#      threads (distinct threads it ran on), thread switches (consecutive runs on different threads: real
#      hops), actor switches (consecutive runs on different actors/executors), continuations (count, total
#      time), scheduling waits before a run (count, median, p90, max: Suspended/Enqueued time right before
#      Running, i.e. from being made runnable to running), lifetime
#   == threads: thread, runs, running time (task code only)
#   == totals: tasks, runs, thread switches, actor switches, continuations, scheduling waits (median, p90)
#   Times in µs. Threads are named as Instruments names them, with their id: "NAME (0x1a2b3c)".
#
# What it can't show: executor *checks* that don't change state. A plain `nonisolated` async function calls
# `swift_task_switch` on entry and after each await to confirm its executor; when it's already right, the
# task never leaves Running, so nothing is recorded. Count those with Tools/runtime-count
# (`--break swift_task_switch@libswift_Concurrency.dylib`). This tool counts actual moves.
#
# PROGRAM is launched as PROGRAM-debuggable (get-task-allow; lib/common.sh). Keep runs short: every task
# state change is recorded. xctrace itself stops PROGRAM at the time limit (--time-limit, else --timeout); if
# xctrace hangs past that (waiting on an authorization prompt), it's interrupted 60 s later, and only the processes
# it started are stopped.
source "$(dirname "$0")/lib/common.sh" || exit 2
have yq || die "needs yq: brew install yq"
have jq || die "needs jq: brew install jq"

top=20 keep='' trace='' limit='' timeout=300
while [[ $# -gt 0 ]]; do
    case "$1" in
        --top) need_value "$@"; need_number "$1" "$2"; top="$2"; shift ;;
        --keep) need_value "$@"; keep="$2"; shift ;;
        --trace) need_value "$@"; trace="$2"; shift ;;
        --time-limit) need_value "$@"; limit="$2"; shift ;;
        --timeout) need_value "$@"; need_number "$1" "$2"; timeout="$2"; shift ;;
        -h|--help) usage ;;
        --) shift; break ;;
        *) die "unknown option $1" ;;
    esac
    shift
done
need_xcode_tools # once here, not in every `| demangle` subshell, and before anything is recorded

# xctrace's --time-limit in whole seconds (rounded up), for the backstop; dies on anything else: no leading zeros
# (bash would read 08 as octal), and at most 10,000,000 s, so the arithmetic can't wrap.
limit_seconds() {
    local number unit seconds
    [[ "$1" =~ ^([1-9][0-9]{0,9})(ms|s|m|h)?$ ]] ||
        die "--time-limit takes a whole number from 1, with ms, s, m, or h (5s), not '$1'"
    number="${BASH_REMATCH[1]}" unit="${BASH_REMATCH[2]}"
    need_number --time-limit "$number"
    case "$unit" in
        ms) seconds=$(((number + 999) / 1000)) ;;
        m) seconds=$((number * 60)) ;;
        h) seconds=$((number * 3600)) ;;
        *) seconds="$number" ;;
    esac
    (( seconds <= 10000000 )) || die "--time-limit $1 is longer than 10,000,000 s"
    echo "$seconds"
}

# How the recording ended, from its table of contents, for messages about an empty table: " (the recording ended: …)".
ended() {
    local reason
    reason="$(xctrace export --input "$trace" --toc 2> /dev/null | perl -ne 'print $1 if m{<end-reason>(.*?)</end-reason>}' || true)"
    [[ -z "$reason" ]] || echo " (the recording ended: $reason)"
}

# --keep: a path ending in .trace that doesn't exist, or an earlier recording (a .trace directory with Instruments'
# form.template), which is replaced. Anything else is refused, never removed.
check_keep() {
    [[ "$1" == *.trace ]] || die "--keep takes a path ending in .trace: $1"
    if [[ -e "$1" || -L "$1" ]]; then
        [[ -d "$1" && ! -L "$1" && -f "$1/form.template" ]] ||
            die "--keep $1 exists and isn't an Instruments recording: refusing to replace it"
    fi
}

scratch_dir
if [[ -z "$trace" ]]; then
    [[ $# -ge 1 ]] || usage 2
    recording_limit="${timeout}s"
    backstop="$timeout"
    if [[ -n "$limit" ]]; then
        seconds="$(limit_seconds "$limit")"
        [[ "$limit" =~ [a-z]$ ]] || limit="${limit}s"
        recording_limit="$limit"
        (( seconds > backstop )) && backstop="$seconds"
    fi
    program="$(debuggable "$1")"; shift
    [[ -z "$keep" ]] || check_keep "$keep"
    trace="${keep:-$SCRATCH/run.trace}"
    [[ ! -d "$trace" ]] || rm -rf "$trace"
    note "recording $(basename "$program") with Swift Concurrency…"
    status=0
    with_timeout $((backstop + 60)) xctrace record --template 'Swift Concurrency' --output "$trace" \
        --time-limit "$recording_limit" --launch -- "$program" "$@" > "$SCRATCH/record.log" 2>&1 < /dev/null || status=$?
    [[ $status != 124 ]] || fail "xctrace didn't finish within $((backstop + 60)) s and was stopped ($AUTH_HINT)"
    [[ -d "$trace" ]] || { tail -5 "$SCRATCH/record.log" >&2; die "xctrace record failed ($AUTH_HINT)"; }
    if [[ -z "$limit" ]] && grep -q 'Reached specified time limit' "$SCRATCH/record.log"; then
        fail "$(basename "$program") didn't finish in ${timeout} s (--timeout) and was stopped${keep:+; the recording is in $keep}"
    fi
fi
[[ -d "$trace" ]] || die "no trace $trace"

# Exported to files, not through a pipeline: under `set -e` a failing export would end the tool with 1 and no word.
if ! { xctrace export --input "$trace" --xpath '/trace-toc/run[@number="1"]/data/table[@schema="SwiftTaskStateTable"]' \
    > "$SCRATCH/states.xml" 2> "$SCRATCH/export.err" && yq -p xml -o json '.' "$SCRATCH/states.xml" > "$SCRATCH/states.json"; }; then
    tail -3 "$SCRATCH/export.err" >&2
    die "xctrace couldn't export SwiftTaskStateTable from $trace"
fi
rows="$(jq '[.["trace-query-result"].node.row // [] | if type == "array" then .[] else . end] | length' "$SCRATCH/states.json" 2> /dev/null || echo 0)"
[[ "$rows" != 0 ]] ||
    die "no Swift task states in $trace$(ended): a failed recording, or a program that ran no Swift concurrency"

# A thread's "+@fmt" is "NAME (0xTID) (PROCESS, pid: N)": only the process suffix is dropped. The thread id stays,
# since every pool thread has the same NAME (the program's).
jq -r --argjson top "$top" '
    ([.. | objects | select(has("+@id"))] | map({key: .["+@id"], value: .}) | from_entries) as $ids
    | def r: if type == "object" and has("+@ref") then $ids[.["+@ref"]] else . end;
      def one: if type == "array" then .[0] else . end;
      def us: . / 1000 | . * 10 | round / 10;
      def pct(p): if length == 0 then null else .[((length - 1) * p) | floor] end;
    [.["trace-query-result"].node.row // [] | if type == "array" then .[] else . end
     | {t: (.["start-time"] | r | .["+content"] | tonumber),
        d: (.duration | r | .["+content"] // "0" | tonumber),
        task: (.["analysis-core-swift-task"] | one | r | .["+@fmt"]),
        state: (.["swift-task-state"] | r | .["+@fmt"]),
        thread: (.thread | r | .["+@fmt"] // "" | sub(" \\([^()]*, pid: [0-9]+\\)$"; "")),
        actor: (.["swift-actor"] | if type == "array" then (.[1] // .[0]) else . end | r | .["+@fmt"] // "")}]
    | sort_by(.t) as $rows
    | ($rows | group_by(.task) | map(
        . as $s
        | ($s | map(select(.state == "Running"))) as $run
        | ([range(1; $s | length) as $i
            | select($s[$i].state == "Running" and ($s[$i - 1].state | test("Suspended|Enqueued")))
            | $s[$i - 1].d] | sort) as $waits
        | ($s | map(select(.state == "Continuation"))) as $cont
        | {task: $s[0].task, runs: ($run | length), running: ($run | map(.d) | add // 0),
           threads: ($run | map(.thread) | unique | length),
           switches: ([range(1; $run | length) as $i | select($run[$i].thread != $run[$i - 1].thread)] | length),
           actorSwitches: ([range(1; $run | length) as $i | select($run[$i].actor != $run[$i - 1].actor)] | length),
           continuations: ($cont | length), continuationTime: ($cont | map(.d) | add // 0),
           waits: $waits, lifetime: (($s[-1].t + $s[-1].d) - $s[0].t)})) as $tasks
    | ($rows | map(select(.state == "Running")) | group_by(.thread)
       | map({thread: .[0].thread, runs: length, running: (map(.d) | add)}) | sort_by(-.running)) as $threads
    | ($tasks | map(.waits) | add // [] | sort) as $allWaits
    | "== tasks",
      (["task", "runs", "running µs", "threads", "thread switches", "actor switches", "continuations",
        "continuation µs", "waits", "wait median µs", "wait p90 µs", "wait max µs", "lifetime µs"] | @tsv),
      ($tasks | sort_by(-.running) | .[0:$top][]
       | [.task, .runs, (.running | us), .threads, .switches, .actorSwitches, .continuations,
          (.continuationTime | us), (.waits | length), (.waits | pct(0.5) // 0 | us),
          (.waits | pct(0.9) // 0 | us), (.waits | last // 0 | us), (.lifetime | us)] | @tsv),
      "== threads",
      (["thread", "runs", "running µs"] | @tsv),
      ($threads[] | [.thread, .runs, (.running | us)] | @tsv),
      "== totals",
      (["tasks", "runs", "thread switches", "actor switches", "continuations", "waits", "wait median µs", "wait p90 µs"] | @tsv),
      ([($tasks | length), ($tasks | map(.runs) | add), ($tasks | map(.switches) | add),
        ($tasks | map(.actorSwitches) | add), ($tasks | map(.continuations) | add), ($allWaits | length),
        ($allWaits | pct(0.5) // 0 | us), ($allWaits | pct(0.9) // 0 | us)] | @tsv)
' "$SCRATCH/states.json" | demangle
