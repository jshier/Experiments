#!/bin/bash
# bench-table — ordo-one/benchmark baselines side by side: one row per benchmark and metric, a column per
# baseline, and the change from the first to the last.
#
# usage: Tools/bench-table PACKAGE_DIR [--metric REGEX] [--filter REGEX] [--percentile P] BASELINE [BASELINE...]
#
#   PACKAGE_DIR    the package with the benchmarks (baselines are in its .benchmarkBaselines/)
#   --metric       metrics to show, a Perl regex on the metric name (default: everything). Names as the
#                  benchmark tool prints them: "Time (wall clock)", "Instructions", "Malloc (total)",
#                  "Throughput (MB/s)" (custom metrics keep their names).
#   --filter       benchmarks to show, a Perl regex on the name
#   --percentile   p0, p25, p50 (default), p75, p90, p99, p100
#
# Output, tab-separated: benchmark, metric, one value per baseline, change (last vs first). Values are in
# base units, whatever scale the tool printed: counts unscaled (its "(K)"/"(M)" removed), times in
# microseconds. Missing values are "-".
#
# Save baselines with: swift package --disable-sandbox benchmark baseline update NAME [--filter …] --no-progress
#
# example:
#   Tools/bench-table Base64 --metric 'Throughput|Instructions' --filter 'Bytes \(' v1 tbl zip final
source "$(dirname "$0")/lib/common.sh"

metric='.' filter='.' percentile=p50 baselines=()
[[ $# -ge 1 && ( "$1" == "-h" || "$1" == "--help" ) ]] && usage
[[ $# -ge 2 ]] || usage 2
package="$1"; shift
while [[ $# -gt 0 ]]; do
    case "$1" in
        --metric) metric="$2"; shift ;;
        --filter) filter="$2"; shift ;;
        --percentile) percentile="$2"; shift ;;
        -h|--help) usage ;;
        -*) die "unknown option $1" ;;
        *) baselines+=("$1") ;;
    esac
    shift
done
[[ ${#baselines[@]} -ge 1 ]] || usage 2
scratch_dir

index=0
for baseline in "${baselines[@]}"; do
    (cd "$package" && swift package --disable-sandbox benchmark baseline read "$baseline" --format markdown --no-progress 2>/dev/null) \
        > "$SCRATCH/$index.md" || true
    grep -q '^### ' "$SCRATCH/$index.md" || die "no baseline $baseline in $package (swift package benchmark baseline list)"
    index=$((index + 1))
done

# Markdown: "### <benchmark>", then "| <Metric> (<unit>) * | p0 | p25 | p50 | … |" rows.
METRIC="$metric" FILTER="$filter" PERCENTILE="$percentile" COUNT="${#baselines[@]}" NAMES="${baselines[*]}" perl -e '
    my %scale = (K => 1e3, M => 1e6, G => 1e9, ns => 1e-3, "μs" => 1, us => 1, ms => 1e3, s => 1e6);
    my @percentiles = qw(p0 p25 p50 p75 p90 p99 p100);
    my ($column) = grep { $percentiles[$_] eq $ENV{PERCENTILE} } 0 .. $#percentiles;
    die "unknown percentile $ENV{PERCENTILE}\n" unless defined $column;
    my (%value, @order, %seen);
    for my $b (0 .. $ENV{COUNT} - 1) {
        open my $f, "<", "$ARGV[0]/$b.md" or die;
        my $bench;
        while (<$f>) {
            if (/^### (.*?)(?: metrics)?\s*$/) { $bench = $1; next }
            next unless defined $bench && /^\|\s*([^|]+?)\s*\|((?:\s*[-\d.,]+\s*\|){7})/;
            my ($name, $cells) = ($1, $2);
            next if $name =~ /^(Metric|:?-+)/;
            my @cells = map { s/[\s,]//gr } grep { length } split /\|/, $cells;
            $name =~ s/\s*\*$//;
            my $factor = 1;
            while ($name =~ s/\s*\((K|M|G|ns|μs|us|ms|s)\)$//) { $factor *= $scale{$1} }
            next unless $name =~ /$ENV{METRIC}/ && $bench =~ /$ENV{FILTER}/;
            my $key = "$bench\t$name";
            push @order, $key unless $seen{$key}++;
            my $v = $cells[$column];
            $value{$key}[$b] = $v eq "-" ? undef : $v * $factor;
        }
    }
    print join("\t", "benchmark", "metric", split(" ", $ENV{NAMES}), "change"), "\n";
    for my $key (sort @order) {
        my @v = map { $value{$key}[$_] } 0 .. $ENV{COUNT} - 1;
        my $change = (@v > 1 && defined $v[0] && defined $v[-1] && $v[0] != 0) ? sprintf("%+.1f%%", 100 * ($v[-1] / $v[0] - 1)) : "-";
        print join("\t", $key, (map { defined $_ ? ($_ == int($_) ? int($_) : sprintf("%.4g", $_)) : "-" } @v), $change), "\n";
    }' "$SCRATCH"
