#!/bin/bash
# mca — static throughput estimate for a compiled loop with llvm-mca: cycles per iteration, IPC, and which
# execution units bind it.
#
# usage: Tools/mca FILE PATTERN [--loop N] [--cpu CPU] [--bottleneck] [--full]
#        Tools/mca --target PACKAGE_DIR TARGET PATTERN [options]
#
#   FILE, --target, PATTERN  as for Tools/loops (one function should match: with several, the first is used and
#                  the others are named on stderr)
#   --loop N       the loop number Tools/loops prints (default: the largest innermost loop)
#   --cpu          LLVM CPU model (default apple-m3; `llvm-mca -mcpu=help` lists them)
#   --bottleneck   add llvm-mca's bottleneck analysis: the share of cycles lost to resource pressure and to data
#                  dependencies, and the critical sequence through the loop
#   --full         llvm-mca's whole report (per-instruction latency and micro-ops, timeline)
#
# llvm-mca runs 500 iterations of a loop up to 100 instructions, 50 of one from 1,000, and 50,000 instructions in all
# between (its time grows with the instructions it runs; IPC settles within a few dozen iterations).
#
# The loop is the one Tools/loops finds (lib/loops.pl): every block of it, in layout order, which needn't be
# contiguous (a cold path laid out after the return is included, as if it ran every iteration). Branches stay in,
# with numeric targets, so the branch units count. Prints the loop's instruction count, llvm-mca's
# "Block RThroughput" (cycles per iteration if nothing but throughput limits it) and IPC, and the resource pressure
# per unit, busiest first. llvm-mca's warnings and notes go to stderr; so does a warning when the loop calls
# (`bl`, `blr`: llvm-mca assumes 100 cycles a call) or holds a `ret`.
#
# Caveat, measured: LLVM's Apple CPU models are derived from the old Cyclone model (3 vector units; every
# `tbl` is one micro-op whatever its table size; `ld3`/`st4` costed simply). It predicted 7.7 cycles per 48
# bytes for both a 7-`tbl` Base64 kernel (measured 9.1) and a C `ld3`/`st4` kernel (measured 8.4). Use it for
# a lower bound and to see which unit saturates, not to rank NEON shuffle strategies: measure those.
#
# Known limits: Tools/loops' (a linked binary's table followed by constants no code refers to directly; ARG_MAX
# shared with a large environment: LOOPS_LIST_MAX).
#
# Needs Homebrew's LLVM (brew install llvm; keg-only, found automatically).
source "$(dirname "$0")/lib/common.sh" || exit 2
# A TERM, HUP, or INT from here on stops everything this starts (lib/stoppable.sh): a --target build too, and the
# scratch directory is removed even if the signal comes before scratch_dir has set its EXIT trap.
source "$TOOLS_DIR/lib/stoppable.sh" || exit 2
stop_on_signals

[[ $# -ge 1 && ( "$1" == "-h" || "$1" == "--help" ) ]] && usage
[[ $# -ge 2 ]] || usage 2
read_input_stoppable "$@"; shift "$INPUT_ARGS"
[[ $# -ge 1 ]] || usage 2
file="$INPUT" pattern="$1"; shift
loop='' cpu=apple-m3 full='' bottleneck=''
while [[ $# -gt 0 ]]; do
    case "$1" in
        --loop) need_value "$@"; need_number --loop "$2"; loop="$2"; shift ;;
        --cpu) need_value "$@"; cpu="$2"; shift ;;
        --bottleneck) bottleneck=1 ;;
        --full) full=1 ;;
        -h|--help) usage ;;
        *) die "unknown option $1" ;;
    esac
    shift
done
need_llvm
scratch_dir

# Tools/loops finds the matches and the first one's loops, and leaves its list of matches and its disassembly here.
# It and llvm-mca run in the background, waited for, so a signal stops them at once (lib/stoppable.sh).
find_loops() { LOOPS_SAVE="$SCRATCH" LOOPS_FIRST=1 "$TOOLS_DIR/loops" "$file" "$pattern" --tsv > "$SCRATCH/loops" 2> "$SCRATCH/loops.err"; }
status=0
run_stoppable find_loops || status=$?
# Tools/loops' own failure (exit 2 and up: a bad file, objdump failing, a signal) is reported as it, never as "no loops".
if [[ $status -gt 1 || ! -s "$SCRATCH/functions" ]]; then
    cat "$SCRATCH/loops.err" >&2
    exit "$((status == 0 ? 1 : status))"
fi
symbol="$(head -1 "$SCRATCH/functions")"
demangled="${symbol#*$'\t'}"
matches="$(grep -c . "$SCRATCH/functions")"
if [[ "$matches" -gt 1 ]]; then
    note "warning: $matches functions match /$pattern/; using the first, $demangled. The others:"
    # Read to the end (a reader that stops early would make its writer die of SIGPIPE under pipefail).
    perl -F'\t' -ane 'chomp $F[1]; print STDERR "  $F[1]\n" if $. > 1 && $. <= 11' "$SCRATCH/functions"
    [[ "$matches" -gt 11 ]] && note "  … and $((matches - 11)) more"
fi
# Columns: function, loop, start, end, instructions, depth, innermost|outer, verdict, mix, headers, pieces, kind. A name
# defined more than once (a merged object) has a row set per copy: the first copy's. The rows must be the first match's.
first_copy="$(perl -F'\t' -ane 'print $F[0] unless $done++' "$SCRATCH/loops")"
[[ -n "$first_copy" && ( "$first_copy" == "$demangled" || "$first_copy" == "$demangled [copy "* ) ]] || fail "no loops in $demangled"
if [[ -n "$loop" ]]; then
    row="$(FUNCTION="$first_copy" LOOP="loop$loop" perl -F'\t' -ane 'print if $F[0] eq $ENV{FUNCTION} && $F[1] eq $ENV{LOOP}' "$SCRATCH/loops")"
    [[ -n "$row" ]] || fail "no loop $loop in $demangled (Tools/loops lists them)"
else
    # The largest innermost loop (of equals, the lowest row as text, as `sort -rn` on the size chose).
    row="$(FUNCTION="$first_copy" perl -F'\t' -ne 'if ($F[0] eq $ENV{FUNCTION} && $F[6] eq "innermost"
            && (!defined $best || $F[4] > $size || ($F[4] == $size && $_ lt $best))) { ($best, $size) = ($_, $F[4]) }
        END { print $best if defined $best }' "$SCRATCH/loops")"
    row="${row%$'\n'}"
    [[ -n "$row" ]] || fail "no innermost loop in $demangled"
fi
IFS=$'\t' read -r _ name start end count _ _ _ _ header pieces kind <<<"$row"
headers="0x${header//,/, 0x}"
if [[ "$kind" == irreducible ]]; then
    entered="entries $headers"
    note "note: $name is an irreducible cycle (entries $headers): llvm-mca runs its blocks in address order"
else
    entered="header $headers"
fi

if [[ "$first_copy" =~ \[copy\ 1\ of\ ([0-9]+),\ at\ (0x[0-9a-f]+)\]$ ]]; then
    note "note: $demangled is defined ${BASH_REMATCH[1]} times (merged objects); using the copy at ${BASH_REMATCH[2]}"
fi

# The loop's instructions, piece by piece in address order, as assembly llvm-mca reads: no addresses, comments, or
# symbolic operands. A pc-relative target (branches, `adr`, `adrp`, literal loads) becomes `.`: objdump prints it as
# an absolute address, which llvm-mca would read as an offset, out of range for most of them.
# Instructions are picked by address from Tools/loops' disassembly (the pieces are the first copy's addresses).
PIECES="$pieces" perl -ne '
        BEGIN { @pieces = map { [map { hex } split /-/] } split /,/, $ENV{PIECES} }
        next if /ARM64_RELOC_/;
        next unless /^\s*([0-9a-f]+):\s+(\S+)\s*(.*)$/;
        my ($a, $m, $o) = (hex $1, $2, $3);
        next if $m =~ /^\./;
        next unless grep { $a >= $_->[0] && $a <= $_->[1] } @pieces;
        $o =~ s/\s*;.*$//;
        $o =~ s/\s*<[^>]*>//g;
        $o =~ s/(^|,\s*)0x[0-9a-f]+\s*$/$1./;
        print "$m $o\n"' "$SCRATCH/disassembly" > "$SCRATCH/loop.s"

perl -ne 'print "$1\n" if /^(bl|blr|blraa\w*|ret\w*)\s/' "$SCRATCH/loop.s" | sort | uniq -c |
    perl -ne 'chomp; s/^\s+//; push @x, $_; END { exit unless @x; my $all = join " ", @x;
        print STDERR "warning: the loop holds ", join(", ", @x), ":",
            ($all =~ /\bbl/ ? " llvm-mca gives a call 100 cycles of latency and nothing of the callee;" : ""),
            ($all =~ /\bret/ ? " a return leaves the loop, yet llvm-mca runs it every iteration;" : ""), " a rough bound\n" }'
pieces_count="$(tr ',' '\n' <<<"$pieces" | grep -c .)"
where="0x${start}–0x${end}"
if [[ "$pieces_count" -gt 1 ]]; then
    where="$where in $pieces_count pieces ($entered)"
elif [[ "$kind" == irreducible ]]; then
    where="$where ($entered)"
fi
echo "$demangled: $name at $where, ${count} instructions, model ${cpu}"
# Iterations scaled to the loop: 500 for up to 100 instructions, 50 from 1,000 (llvm-mca's time grows with both; its
# throughput and IPC settle within a few dozen iterations of even the largest loops).
iterations=$(( 50000 / (count > 0 ? count : 1) ))
(( iterations > 500 )) && iterations=500
(( iterations < 50 )) && iterations=50
mca_args=(-mtriple=arm64-apple-macos -mcpu="$cpu" -iterations="$iterations")
[[ -n "$bottleneck" ]] && mca_args+=(-bottleneck-analysis)
if [[ -n "$full" ]]; then
    run_stoppable "$LLVM_BIN/llvm-mca" "${mca_args[@]}" "$SCRATCH/loop.s"
    exit 0
fi
run_stoppable "$LLVM_BIN/llvm-mca" "${mca_args[@]}" "$SCRATCH/loop.s" > "$SCRATCH/report" 2> "$SCRATCH/stderr" ||
    { cat "$SCRATCH/stderr" "$SCRATCH/report" >&2; die "llvm-mca failed"; }
# llvm-mca's warnings and notes ("found a call in the input assembly sequence").
grep -E '(warning|note|error):' "$SCRATCH/stderr" >&2 || true
grep -E "^(Block RThroughput|IPC|uOps Per Cycle):" "$SCRATCH/report" | sed 's/^/  /'
echo "  resource pressure per iteration, busiest units:"
perl -ne '
    if (/^\[([\d.]+)\]\s+-\s+(\S+)/) { $name{$1} = $2 }
    if (/^Resource pressure per iteration:/) { $header = <>; $values = <>; @h = $header =~ /\[([\d.]+)\]/g; @v = split " ", $values;
        for my $i (0 .. $#h) { $p{$h[$i]} = $v[$i] } }
    END { my %unit; for (keys %p) { next if $p{$_} eq "-"; $unit{$name{$_} // $_} += $p{$_} }
          my @units = sort { $unit{$b} <=> $unit{$a} || $a cmp $b } keys %unit;
          printf "    %-12s %6.2f\n", $_, $unit{$_} for @units[0 .. ($#units < 5 ? $#units : 5)] }' "$SCRATCH/report"
if [[ -n "$bottleneck" ]]; then
    echo "  bottleneck analysis:"
    perl -ne '$in = 1 if /^(Cycles with backend pressure|No resource or data dependency bottlenecks)/; last if $in && /^Instruction Info:/; print "    $_" if $in' "$SCRATCH/report" |
        perl -e 'my @l = <>; pop @l while @l && $l[-1] =~ /^\s*$/; print @l'
fi
echo "  (Apple models are Cyclone-derived: a bound, not a prediction for NEON shuffles. See --help.)"
